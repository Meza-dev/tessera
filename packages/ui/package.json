    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tessera/motion": "^0.1.0 || ^0.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "motion": "^14.14.0"
  }
