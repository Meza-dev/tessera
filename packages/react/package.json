{
  "name": "@tessera-system/tessera",
  "version": "0.1.0",
  "description": "TESSERA design tokens, Geist fonts, motion styles and React components.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meza-dev/tessera.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#motion-tokens": "./dist/tokens.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css",
    "./motion.css": "./dist/motion.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/stage-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "motion": "^14.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "motion": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  }
}
