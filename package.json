{
  "name": "tessera-workspace",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @tessera/motion && npm run build --workspace @tessera/ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "npm run typecheck --workspace @tessera/ui && tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.7",
    "storybook": "10.6.7",
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "overrides": {
    "@storybook/react-vite@10.6.7": {
      "@joshwooding/vite-plugin-react-docgen-typescript": "0.9.1"
    }
  }
}
